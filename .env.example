# ==========================================
# ATRIA - Environment configuration
# ==========================================
# Copy this file to .env and change the values. Atria reads .env when it starts.

# The environment: development, test, or production.
# Any other value, or no value, has the same effect as production.
# Only in development does the web interface log you in automatically as ATRIA_USER.
ATRIA_ENV=development

# The user for CLI commands. The CLI does all its work as this user.
# In development, the web interface also logs you in as this user without a password.
ATRIA_USER=admin@atria.local

# The port of the web server.
PORT=8080

# The IP address of the web server. Empty means all network interfaces.
# If a reverse proxy on the same machine is in front of Atria, use 127.0.0.1.
# Then clients cannot get to Atria past the proxy and its login.
# The `atria server --host` flag has priority over this value.
# ATRIA_HOST=127.0.0.1

# If true, the web server writes debug messages to the log, for example each login decision.
# This setting does not change how login works. You can use it in production for a short time.
# DEBUG=true

# ==========================================
# DATABASE
# Format: postgres://user:password@host:port/database?sslmode=disable
# ==========================================
# The database of the application.
DATABASE_URL=postgres://atria_user:secretpassword@localhost:5432/atria_dev?sslmode=disable

# The database for the automatic tests only.
# Warning: each test deletes all tables in this database. Do not use a database with real data.
# The name of the database must contain "test". If it does not, the tests stop.
TEST_DATABASE_URL=postgres://atria_user:secretpassword@localhost:5432/atria_test?sslmode=disable

# ==========================================
# STORAGE
# ==========================================
# The directory for files: attachments, e-books, and EPUB exports.
# The database keeps only a reference to each file.
# The path can be relative (./data/attachments) or absolute (/var/lib/atria/attachments).
STORAGE_PATH=./data/attachments

# The maximum size of one request in MB, for example an uploaded attachment or e-book.
# Default: 100
# MAX_UPLOAD_MB=100

# ==========================================
# SECURITY
# ==========================================
# A random secret value. Atria uses it to sign login cookies and CSRF tokens.
# (A CSRF token stops other web sites from sending forms in your name.)
# You must set it outside development. Without it, or with this example value, the server does not start.
# To make a new value, run: openssl rand -hex 32
SESSION_SECRET=super-secret-dev-key-change-me

# ==========================================
# RSS
# ==========================================
# The time between two checks for new RSS items, in minutes. Default: 20
# RSS_FETCH_INTERVAL=20

# After this number of days, Atria deletes the text of read RSS items.
# The title and the link stay. Atria never changes unread items. The cleanup runs each day.
# Default: 180
# RSS_RETENTION_DAYS=180

# ==========================================
# LOGIN THROUGH A REVERSE PROXY (Authelia, Authentik, and similar)
# ==========================================
# A reverse proxy is the web server in front of Atria, for example Angie, Nginx, or Traefik.

# The IP addresses of your reverse proxies, separated by commas.
# Atria reads the IP address of the client from the X-Forwarded-For header only when the request comes from one of these addresses.
# Atria uses that client address, for example, to limit failed login attempts.
TRUSTED_PROXIES=127.0.0.1,::1

# The IP addresses that can send the login header (PROXY_AUTH_HEADER), separated by commas.
# Atria compares this list with the IP address of the direct connection, not with X-Forwarded-For.
# Thus use the IP address of the proxy as Atria sees it.
# Warning: if this value is empty, Atria ignores the login header and login through the proxy does not work.
PROXY_ALLOWLIST=127.0.0.1,::1

# The HTTP header in which the proxy sends the e-mail address of the logged-in user.
# Default: Remote-Email (the header of Authelia).
PROXY_AUTH_HEADER=Remote-Email

# The page where users manage their account. The profile page links to it.
SSO_MANAGEMENT_URL=https://auth.example.com

# The page to open after logout, for example the logout page of Authelia.
SSO_LOGOUT_URL=https://auth.example.com/logout
